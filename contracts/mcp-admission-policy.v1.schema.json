{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Operator MCP run admission policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "servers"],
  "properties": {
    "version": { "const": 1, "type": "integer" },
    "servers": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url", "gatewayUrl", "serverHostId", "executionHostIds"],
        "properties": {
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[\\u0000-\\u007f]+(?![\\s\\S])"
          },
          "gatewayUrl": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048,
            "pattern": "^[\\u0000-\\u007f]+(?![\\s\\S])"
          },
          "serverHostId": {
            "type": "string",
            "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
          },
          "executionHostIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 64,
            "items": {
              "type": "string",
              "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
            }
          }
        }
      }
    }
  }
}
