{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MCP run delivery binding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["runId", "executionHostId", "serverHostId", "gatewayUrl"],
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
    },
    "executionHostId": {
      "type": "string",
      "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
    },
    "serverHostId": {
      "type": "string",
      "pattern": "^[\\u0021-\\u007e]{1,128}(?![\\s\\S])"
    },
    "gatewayUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048,
      "pattern": "^[\\u0000-\\u007f]+(?![\\s\\S])"
    },
    "authorizedCrossHost": { "type": "boolean" }
  }
}
